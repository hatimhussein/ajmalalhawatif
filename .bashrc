alias pas="php artisan serv"
alias Module="php artisan module:make"
alias migrate="php artisan migrate"
alias mm="php artisan module:make-migration"
alias mc="php artisan module:make-controller"
alias model="php artisan module:make-model"
alias mmodel="php artisan module:make-model -m"
alias middleware="php artisan module:make-middleware"
alias request="php artisan module:make-request"
alias resource="php artisan module:make-resource"
alias component="php artisan module:make-livewire"
